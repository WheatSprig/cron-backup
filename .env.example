# v2 全局默认
TZ=Asia/Shanghai
LOG_TARGET=console
LOG_FILE=/var/log/cron-backup/backup.log
LOG_MAX_SIZE_MB=50
LOG_MAX_FILES=3
DRY_RUN=false
# 默认 webhook；也可在 config.yaml 的 notify 中按 job 覆盖
NOTIFY_URL=
# 跨容器执行 prune 时，指向一个共享可写卷，保证和 run 使用同一把 job 锁
# CRONBACKUP_LOCK_DIR=/backup/.cron-backup-locks

# 凭据只在 env 中维护，config.yaml 里写 ${VAR}
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SFTP_PASSWORD=
PGPASSWORD=
NTFY_URL=
HEALTHCHECKS_URL=
WEBHOOK_URL=

# 镜像构建参数
UID=1000
GID=1000

# 以下变量只在没有 config.yaml 时生效，用于兼容 v1 单 job 部署
# BACKUP_SRC=/backup/data
# CRON_SCHEDULE="0 2 * * *"
# RCLONE_REMOTE_NAMES=backup
# RCLONE_PATH=/backups
# RCLONE_backup_TYPE=s3
# RCLONE_backup_PROVIDER=Minio
# RCLONE_backup_ENDPOINT=https://s3.example.com
# RCLONE_backup_REGION=us-east-1
# RCLONE_backup_BUCKET=backups
# RCLONE_backup_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
# RCLONE_backup_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
